{
  "info": {
    "name": "Bonus Service API",
    "_postman_id": "b0a1c2d3-1111-4444-8888-bonus0000001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bonus / loyalty points service.\n\nHow to use:\n1. Set the `base_url` variable. Local (via proxy): http://localhost:8080. Deployed VM: http://10.93.26.189:8080.\n2. Run the requests top to bottom. Accrual creates points, then balance, hold, confirm, a second hold and cancel, then history.\n3. Write requests send a fresh `Idempotency-Key` ({{$guid}}) on every send, so each click is a new operation. The \"Accrual (idempotency demo)\" request uses a fixed key on purpose: send it twice to see 201 then 409.\n\nMoney values are integers (no decimals)."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "user_id", "value": "653f535d-10ba-4186-a05b-74493354f13b", "type": "string" },
    { "key": "order_id", "value": "a0000000-0000-0000-0000-0000000c0001", "type": "string" },
    { "key": "order_id_cancel", "value": "a0000000-0000-0000-0000-0000000c0002", "type": "string" }
  ],
  "item": [
    {
      "name": "Accrual",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_id\": \"{{user_id}}\",\n    \"amount\": 500,\n    \"days\": 30\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/accrual",
          "host": ["{{base_url}}"],
          "path": ["accrual"]
        },
        "description": "Accrue points for a user with a TTL of `days`. Returns the new batch id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Returns batch_id\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"batch_id\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Accrual (idempotency demo)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "11111111-1111-1111-1111-111111111111" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_id\": \"{{user_id}}\",\n    \"amount\": 500,\n    \"days\": 30\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/accrual",
          "host": ["{{base_url}}"],
          "path": ["accrual"]
        },
        "description": "Same request with a FIXED Idempotency-Key. First send returns 201, every send after that returns 409 (the key is already used). This demonstrates idempotency."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 (first send) or 409 (repeat)\", function () {",
              "    pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}/balance",
          "host": ["{{base_url}}"],
          "path": ["users", "{{user_id}}", "balance"]
        },
        "description": "Available points. Unknown user returns a zeroed balance, not 404."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Has available\", function () {",
              "    var b = pm.response.json();",
              "    pm.expect(b).to.have.property(\"available\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Expirations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}/balance/expirations?days=30",
          "host": ["{{base_url}}"],
          "path": ["users", "{{user_id}}", "balance", "expirations"],
          "query": [
            { "key": "days", "value": "30" }
          ]
        },
        "description": "Returns points expiring within N days"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Has expiring field', function () {",
              "    var b = pm.response.json();",
              "    pm.expect(b).to.have.property('expiring');",
              "    pm.expect(typeof b.expiring).to.eql('number');",
              "    pm.expect(b.expiring).to.be.at.least(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Holds",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}/holds",
          "host": ["{{base_url}}"],
          "path": ["users", "{{user_id}}", "holds"]
        },
        "description": "Returns the total amount of points currently frozen/held for the user."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns amount\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"amount\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Hold",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_id\": \"{{user_id}}\",\n    \"order_id\": \"{{order_id}}\",\n    \"amount\": 200,\n    \"hours\": 24\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/hold",
          "host": ["{{base_url}}"],
          "path": ["hold"]
        },
        "description": "Reserve points for an order (available -> held), FEFO across batches. Expires after `hours` if not confirmed or cancelled. 409 if not enough balance."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Returns hold_id\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"hold_id\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm Hold",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}/holds/{{order_id}}/confirm",
          "host": ["{{base_url}}"],
          "path": ["users", "{{user_id}}", "holds", "{{order_id}}", "confirm"]
        },
        "description": "Finalize the reservation made by \"Create Hold\" for {{order_id}}. Held points are spent for good."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Hold (for cancel)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_id\": \"{{user_id}}\",\n    \"order_id\": \"{{order_id_cancel}}\",\n    \"amount\": 100,\n    \"hours\": 24\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/hold",
          "host": ["{{base_url}}"],
          "path": ["hold"]
        },
        "description": "A second hold on a different order, so the next request has something to cancel."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel Hold",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}/holds/{{order_id_cancel}}/cancel",
          "host": ["{{base_url}}"],
          "path": ["users", "{{user_id}}", "holds", "{{order_id_cancel}}", "cancel"]
        },
        "description": "Release the reservation made by \"Create Hold (for cancel)\". Held points return to available."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}/history?limit=50&offset=0",
          "host": ["{{base_url}}"],
          "path": ["users", "{{user_id}}", "history"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "offset", "value": "0" }
          ]
        },
        "description": "Paginated ledger of operations, newest first. Exposes only operation_type, amount and created_at."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Has transactions array\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"transactions\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
